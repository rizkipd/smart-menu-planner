{
  "expo": {
    "name": "Smart Menu Planner",
    "slug": "smart-menu-planner",
    "version": "1.0.0", 
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f8f7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartmenuplanner.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f6f8f7"
      },
      "package": "com.smartmenuplanner.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "smart-menu-planner",
    "platforms": ["ios", "android", "web"],
    "plugins": [
      "expo-router"
    ]
  }
}